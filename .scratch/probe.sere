class Machine:
    A: i64
    Z: bool

    @private mem: i64

    def __init__(self) -> None:
        self.A = 0
        self.Z = False
        self.mem = 0

    def read(self, address: i64) -> byte:
        return 0x11

    def write(self, address: i64, value: byte) -> void:
        self.mem = address + (value as i64)

    def status(self) -> byte:
        value = 0x20
        if self.Z:
            value = value | 0x02
        return value as byte


struct Operand:
    address: i64
    page_crossed: bool


type HandlerFn = Callable[[Ptr[Machine], Operand], i64]


struct Instruction:
    mnemonic: str
    cycles: i64
    handler: HandlerFn

    def __str__(self) -> str:
        return f"{self.mnemonic} ({self.cycles} cycles)"


def _lda(vm: Ptr[Machine], operand: Operand) -> i64:
    value = (*vm).read(operand.address) as i64
    (*vm).A = value
    (*vm).Z = value == 0
    if operand.page_crossed:
        return 1
    return 0


def operand_size(mode: i64) -> i64:
    match mode:
        case 0 | 1 | 2:
            return 0
        case 3:
            return 1
        case _:
            return 2


def build() -> dict[byte, Instruction]:
    table: dict[byte, Instruction] = {}
    table[0xA9] = Instruction("LDA", 2, _lda)
    table.set(0xA5, Instruction("LDA", 3, _lda))
    return table


static TABLE: dict[byte, Instruction] = build()
static machine: Machine = Machine()


def main() -> i32:
    entry = TABLE.get(0xA9)
    if entry is not None:
        extra = entry.handler(&machine, Operand(0, False))
        print(extra)
        print(entry)
    print(len(TABLE))

    print(f"{machine.A:04X}")
    print(machine.status())

    value = 0x1234
    print((value >> 8) & 0xFF)
    print((value & 0xFF00) | ((value + 1) & 0xFF))
    print(not machine.Z)
    print(operand_size(3))

    i = 0
    while i < 3:
        i += 1
    print(i)

    print("abs " + "$1234")
    print("PA" == "PA")
    return 0
