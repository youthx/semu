class Box:
    value: i64

    def __init__(self) -> None:
        self.value = 0

    def set_value(self, v: i64) -> None:
        self.value = v


class Holder:
    @private box: Box

    def __init__(self, box: Box) -> None:
        self.box = box

    def bump(self) -> None:
        self.box.set_value(0x44)


static box: Box = Box()
static holder: Holder = Holder(box)


def main() -> i32:
    print(box.value)
    holder.bump()
    print(box.value)
    return 0
