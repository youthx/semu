class Box:
    value: i64

    def __init__(self) -> None:
        self.value = 0

    def set_value(self, v: i64) -> None:
        self.value = v


static sbox: Box = Box()


def mutate_static() -> None:
    sbox.set_value(0x11)
    print(sbox.value)  # 17 if static mutation persists


class PtrHolder:
    @private target: Ptr[Box]

    def __init__(self, target: Ptr[Box]) -> None:
        self.target = target

    def bump(self, v: i64) -> None:
        (*self.target).set_value(v)


class SharedHolder:
    @private target: Shared[Box]

    def __init__(self, target: Shared[Box]) -> None:
        self.target = target

    def bump(self, v: i64) -> None:
        (*self.target).set_value(v)


def ptr_holder() -> None:
    box = Box()
    holder = PtrHolder(&box)
    holder.bump(0x22)
    print(box.value)  # 34 if Ptr shares


def shared_holder() -> None:
    box: Shared[Box] = shared[Box](Box())
    holder = SharedHolder(box)
    holder.bump(0x33)
    print((*box).value)  # 51 if Shared shares


def main() -> i32:
    print("mutate_static")
    mutate_static()
    print("ptr_holder")
    ptr_holder()
    print("shared_holder")
    shared_holder()
    return 0
