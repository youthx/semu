# --- introspection ---------------------------------------------------------

def hex_byte(value: i64) -> str:
    digits = "0123456789ABCDEF"
    return digits[(value >> 4) & 0x0F] + digits[value & 0x0F]


# Scratch address the audit uses to build an opcode byte.
const AUDIT_ADDRESS: i64 = 0x02FF


# How many opcodes the table holds, for a quick sanity check from the CLI.
def table_size() -> i64:
    return len(INST_MAP)


# Table reads only answer when the key reaches the lookup as a `byte`
# parameter, which is exactly how `execute` receives its opcode. A key built
# inline, cast with `as byte` or stored in a local all miss the table.
def has_entry(opcode: byte) -> bool:
    return INST_MAP.get(opcode) is not None


def entry_name(opcode: byte) -> str:
    entry = INST_MAP.get(opcode)
    if entry is None:
        return ""
    return str(entry)


# The audit walks all 256 values through a scratch byte in RAM so the key has
# the same shape as the `byte` parameter above.
def audit_key(vm: Ptr[VM], index: i64) -> byte:
    (*vm).write(AUDIT_ADDRESS, index as byte)
    return (*vm).read(AUDIT_ADDRESS)


# One line per implemented opcode, so the table can be audited from the CLI.
def dump_table(vm: Ptr[VM]) -> str:
    lines = ""
    index = 0
    while index < 256:
        name = entry_name(audit_key(vm, index))
        if len(name) > 0:
            lines = lines + f"${hex_byte(index)}  {name}" + bytes.to_str(bytes.from_hex("0A"))
        index += 1
    return lines


# Opcodes the table has no entry for, as a space separated hex list.
def missing_opcodes(vm: Ptr[VM]) -> str:
    text = ""
    index = 0
    while index < 256:
        if not has_entry(audit_key(vm, index)):
            text = text + hex_byte(index) + " "
        index += 1
    return text


def implemented_count(vm: Ptr[VM]) -> i64:
    count = 0
    index = 0
    while index < 256:
        if has_entry(audit_key(vm, index)):
            count += 1
        index += 1
    return count


# Decode `opcode` and run it against `vm`, charging its cycle cost.
# Returns false when the opcode is not implemented.
def execute(vm: Ptr[VM], opcode: byte) -> bool:
    instruction = INST_MAP.get(opcode)
    if instruction is None:
        return False

    operand = resolve(vm, instruction.mode)
    (*vm).add_cycles(instruction.cycles)
    if instruction.page_penalty != 0 and operand.page_crossed:
        (*vm).add_cycles(1)

    instruction.handler(vm, operand.address, operand.value as i64)
    return True


# Human-readable text for an opcode, e.g. "LDA absolute,X".
def mnemonic(opcode: byte) -> str:
    instruction = INST_MAP.get(opcode)
    if instruction is None:
        return "unknown"

    return str(instruction)
