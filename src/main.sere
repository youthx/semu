import bytes
import env
import fs
import log
import string

import asm6502
import processor
from graphics import gfx_blit, gfx_frame, gfx_init, gfx_poll, gfx_shutdown, input_state
from graphics import ACTION_FASTER, ACTION_QUIT, ACTION_RESET, ACTION_SLOWER, ACTION_STEP, ACTION_TOGGLE_RUN
from graphics import STATE_READY, STATE_ERROR, STATE_HALTED, STATE_PAUSED, STATE_RUNNING, STATE_ENDED
from vm import PROGRAM_START, VM

# Where the host keyboard is published for the CPU to read. The NES uses $4016
# for controller 1, so programs written for that port work unchanged.
const INPUT_PORT: i64 = 0x4016

const MEMORY_SIZE: i64 = 65536
const HEX_DIGITS: str = "0123456789ABCDEF"

# Video memory: 128x128 pixels, one RGB332 byte per pixel, at $4000-$7FFF.
const SCREEN_W: i64 = 128
const SCREEN_H: i64 = 128
const SCREEN_ZOOM: i64 = 2
const SCREEN_BASE: i64 = 0x4000
const BLIT_CHUNKS: i64 = 2048

# Cycles the CPU may spend per displayed frame.
const MIN_SPEED: i64 = 250
const MAX_SPEED: i64 = 250000
const DEFAULT_SPEED: i64 = 12000

static vm: VM = VM(MEMORY_SIZE)
static logger: log.Logger = log.get_logger("semu")

# The address window of the loaded program. A flat image has no natural end, so
# the CPU stops when it runs past the last byte instead of executing whatever
# happens to follow in memory.
static program_start: i64 = 0
static program_end: i64 = 0
static program_ended: bool = False


def hex_byte(value: i64) -> str:
    return HEX_DIGITS[(value >> 4) & 0x0F] + HEX_DIGITS[value & 0x0F]


def hex_word(value: i64) -> str:
    return hex_byte((value >> 8) & 0xFF) + hex_byte(value & 0xFF)


def newline() -> str:
    return bytes.to_str(bytes.from_hex("0A"))


# --- program selection -----------------------------------------------------
# A program can come from SEMU_PROGRAM or from the command line:
#   sere run -- game.s --org=0x8000
# Without either, the built in demo below is assembled and run.

def program_path(argv: list[str]) -> str:
    from_env = env.get("SEMU_PROGRAM")
    if len(from_env) > 0:
        return from_env
    i = 1
    while i < i32(len(argv)):
        arg = argv[i]
        if not string.starts_with(arg, "--"):
            return arg
        i += 1
    return ""


def program_origin(argv: list[str]) -> i64:
    i = 1
    while i < i32(len(argv)):
        arg = argv[i]
        if string.starts_with(arg, "--org="):
            return parse_address(arg[6:])
        i += 1
    return PROGRAM_START


def parse_address(text: str) -> i64:
    body = string.strip(text)
    if len(body) == 0:
        return PROGRAM_START
    if body[0] == "$":
        return hex_digits(body[1:])
    if string.starts_with(string.upper(body), "0X"):
        return hex_digits(body[2:])
    return decimal_digits(body)


def hex_digits(text: str) -> i64:
    digits = "0123456789ABCDEF"
    value = 0
    i = 0
    while i < i32(len(text)):
        glyph = string.upper(text[i])
        digit = 0
        while digit < 16:
            if glyph == digits[digit]:
                break
            digit += 1
        value = value * 16 + digit
        i += 1
    return value


def decimal_digits(text: str) -> i64:
    value = 0
    i = 0
    while i < i32(len(text)) and text[i] >= "0" and text[i] <= "9":
        value = value * 10 + hex_digits(text[i])
        i += 1
    return value


def has_suffix(name: str, suffix: str) -> bool:
    if len(name) < len(suffix):
        return False
    return string.upper(name[len(name) - len(suffix):]) == string.upper(suffix)


# Built in demo, assembled by asm6502 at startup. It clears the screen, reads
# the host keyboard from $4016 and draws a bar you can steer with the arrow
# keys, repainting it with X (A button) or Z (B button).
const DEMO = """
PORT  = $4016
POS   = $10
COLOR = $11

        LDA #$40
        STA POS
        LDA #$3C
        STA COLOR

loop:
        JSR clear
        JSR read_pad
        LDX POS
        LDA COLOR
        STA $4000,X
        JMP loop

read_pad:
        LDA PORT
        AND #%01000000
        BEQ pad_right
        DEC POS
pad_right:
        LDA PORT
        AND #%10000000
        BEQ pad_up
        INC POS
pad_up:
        LDA PORT
        AND #%00010000
        BEQ pad_down
        INC COLOR
pad_down:
        LDA PORT
        AND #%00100000
        BEQ pad_a
        DEC COLOR
pad_a:
        LDA PORT
        AND #%00000001
        BEQ pad_end
        LDA #$E0
        STA COLOR
pad_end:
        RTS

clear:
        LDX #$00
        LDA #$00
clr:
        STA $4000,X
        INX
        CPX #$80
        BNE clr
        RTS
"""


# Video memory is black until a program draws to it.
def clear_screen() -> void:
    i = 0
    while i < SCREEN_W * SCREEN_H:
        vm.write(SCREEN_BASE + i, 0 as byte)
        i += 1


# Assemble source and load the result at `origin`.
def load_source(source: str, origin: i64) -> bool:
    program = asm6502.assemble(source, origin)
    if not program.ok():
        logger.error("assembly failed:" + newline() + program.errors)
        return False
    logger.info(f"assembled {program.size} bytes at ${hex_word(origin)}")
    program_start = origin
    program_end = origin + program.size
    program_ended = False
    vm.load(asm6502.code_window(program), origin)
    return True


# Load a program file: .s/.asm/.a65 source, a .hex dump, or a raw .bin image.
def load_path(path: str, origin: i64) -> bool:
    if has_suffix(path, ".nes"):
        logger.error(".nes ROMs need the NES bus, mappers and PPU first")
        return False
    text = fs.read_text(path)
    if len(text) == 0:
        logger.error(f"could not read {path}")
        return False
    if has_suffix(path, ".s") or has_suffix(path, ".asm") or has_suffix(path, ".a65"):
        return load_source(text, origin)
    image: list[byte] = bytes.zeros(0)
    if has_suffix(path, ".hex"):
        image = bytes.from_hex(text)
    else:
        image = bytes.from_str(text)
    logger.info(f"loaded {len(image)} bytes from {path} at ${hex_word(origin)}")
    program_start = origin
    program_end = origin + len(image)
    program_ended = False
    vm.load(image, origin)
    return True


def load_program(argv: list[str]) -> bool:
    program_ended = False
    vm.reset(PROGRAM_START)
    clear_screen()
    path = program_path(argv)
    if len(path) > 0:
        if load_path(path, program_origin(argv)):
            vm.run()
            return True
        logger.error("falling back to the built in demo")
    if load_source(DEMO, PROGRAM_START):
        vm.run()
        return True
    return False


# True while the program counter is inside the loaded image.
def in_program() -> bool:
    if program_end <= program_start:
        return True
    return vm.pc >= program_start and vm.pc < program_end


# Runs a program without opening a window, then reports the CPU state. Handy
# for checking a ROM from the command line.
def run_headless(argv: list[str], limit: i64) -> i32:
    if not load_program(argv):
        return 1
    executed = 0
    while executed < limit:
        if not vm.is_running():
            break
        if not in_program():
            print("program ended")
            break
        if not step():
            break
        executed += 1
    print(f"steps   {executed}")
    print(f"state   A=${hex_byte(vm.A)} X=${hex_byte(vm.X)} Y=${hex_byte(vm.Y)} SP=${hex_byte(vm.SP)} P=${hex_byte(vm.P)} PC=${hex_word(vm.pc)}")
    print(f"$0300   ${hex_byte(vm.read(0x0300))} ${hex_byte(vm.read(0x0301))} ${hex_byte(vm.read(0x0302))} ${hex_byte(vm.read(0x0303))}")
    peek = option_value(argv, "--peek=")
    if len(peek) > 0:
        peek_memory(peek)
    return 0


# --peek=0x4000:64 dumps memory as hex, so a windowless run can be inspected.
def peek_memory(spec: str) -> void:
    colon = string.find(spec, ":")
    address = parse_address(spec)
    count = 64
    if colon >= 0:
        count = parse_address(spec[colon + 1:])
    index = 0
    line = ""
    while index < count:
        if index % 16 == 0:
            if index > 0:
                print(line)
            line = hex_word(address + index)
        line = line + " " + hex_byte(vm.read(address + index) as i64)
        index += 1
    if len(line) > 0:
        print(line)


# Fetch, decode and run one instruction. The machine is passed as &vm so the
# handlers mutate this VM rather than a copy of it.
def step() -> bool:
    opcode = vm.read_byte()
    if not processor.execute(&vm, opcode):
        logger.error(f"unknown opcode ${hex_byte(opcode)} at ${hex_word(vm.pc - 1)}")
        return False
    return True


# Copy video memory into the window texture, eight pixels per call.
def blit_screen() -> void:
    chunk = 0
    while chunk < BLIT_CHUNKS:
        base = SCREEN_BASE + chunk * 8
        packed = vm.read(base) as i64
        packed = packed | ((vm.read(base + 1) as i64) << 8)
        packed = packed | ((vm.read(base + 2) as i64) << 16)
        packed = packed | ((vm.read(base + 3) as i64) << 24)
        packed = packed | ((vm.read(base + 4) as i64) << 32)
        packed = packed | ((vm.read(base + 5) as i64) << 40)
        packed = packed | ((vm.read(base + 6) as i64) << 48)
        packed = packed | ((vm.read(base + 7) as i64) << 56)
        gfx_blit(chunk, packed)
        chunk += 1


def option_value(argv: list[str], prefix: str) -> str:
    i = 1
    while i < i32(len(argv)):
        arg = argv[i]
        if string.starts_with(arg, prefix):
            return arg[len(prefix):]
        i += 1
    return ""


def has_option(argv: list[str], name: str) -> bool:
    i = 1
    while i < i32(len(argv)):
        if argv[i] == name:
            return True
        i += 1
    return False


# Assembles a program without opening a window: --check reports it, --out=path
# writes the bytes as hex text so they can be loaded back as a binary object.
def compile_only(argv: list[str], out_path: str) -> i32:
    path = program_path(argv)
    origin = program_origin(argv)
    source = DEMO
    if len(path) > 0:
        if not (has_suffix(path, ".s") or has_suffix(path, ".asm") or has_suffix(path, ".a65")):
            logger.error(f"{path} is not an assembly source")
            return 1
        source = fs.read_text(path)
    if len(source) == 0:
        logger.error(f"could not read {path}")
        return 1
    program = asm6502.assemble(source, origin)
    if not program.ok():
        logger.error("assembly failed:" + newline() + program.errors)
        return 1
    logger.info(f"assembled {program.size} bytes at ${hex_word(origin)}")
    if has_option(argv, "--symbols"):
        print(string.replace(program.symbols, ";", newline()))
    if len(out_path) > 0:
        if not fs.write_text(out_path, asm6502.code_hex(program)):
            logger.error(f"could not write {out_path}")
            return 1
        logger.info(f"wrote {out_path}")
        return 0
    dump = asm6502.code_hex(program)
    if len(dump) > 64:
        dump = dump[:64] + "..."
    print(f"${hex_word(origin)} {program.size} bytes {dump}")
    return 0


def main(argv: list[str]) -> i32:
    if has_option(argv, "--dump-cpu"):
        logger.info(f"table entries: {processor.table_size()}")
        print(processor.dump_table(&vm))
        logger.info(f"{processor.implemented_count(&vm)} opcodes implemented")
        missing = processor.missing_opcodes(&vm)
        if len(missing) > 0:
            logger.info(f"no entry for: {missing}")
        return 0

    out_path = option_value(argv, "--out=")
    run_count = option_value(argv, "--run=")
    if len(run_count) > 0:
        return run_headless(argv, parse_address(run_count))
    if has_option(argv, "--check") or len(out_path) > 0:
        return compile_only(argv, out_path)

    if gfx_init(SCREEN_W, SCREEN_H, SCREEN_ZOOM) == 0:
        logger.error("could not open an SDL3 window (is SDL3.dll available?)")
        return 1

    load_program(argv)

    paused = False
    failed = False
    speed = DEFAULT_SPEED

    while True:
        action = gfx_poll()

        if action == ACTION_QUIT:
            break
        elif action == ACTION_TOGGLE_RUN:
            if paused:
                paused = False
                if not vm.is_running():
                    load_program(argv)
            else:
                paused = True
        elif action == ACTION_STEP:
            paused = True
            if not vm.is_running():
                load_program(argv)
            if in_program():
                step()
            else:
                program_ended = True
                vm.halt()
            blit_screen()
        elif action == ACTION_RESET:
            # Reload the program but leave the CPU stopped: reset should not
            # start running again, press RUN or STEP to continue.
            load_program(argv)
            failed = False
            paused = True
        elif action == ACTION_FASTER:
            if speed < MAX_SPEED:
                speed = speed << 1
        elif action == ACTION_SLOWER:
            if speed > MIN_SPEED:
                speed = speed >> 1

        # Publish the host keyboard on the controller port the CPU reads.
        vm.write(INPUT_PORT, input_state() as byte)

        if not paused:
            used = 0
            while used < speed and vm.is_running():
                if not in_program():
                    # Ran past the last byte of the image: stop cleanly.
                    program_ended = True
                    vm.halt()
                    break
                before = vm.cycles
                if not step():
                    failed = True
                    paused = True
                    break
                used += vm.cycles - before
            if not failed:
                blit_screen()

        state = STATE_READY
        if failed:
            state = STATE_ERROR
        elif program_ended:
            state = STATE_ENDED
        elif not vm.is_running():
            state = STATE_HALTED
        elif paused:
            state = STATE_PAUSED
        else:
            state = STATE_RUNNING

        gfx_frame(vm.A, vm.X, vm.Y, vm.SP, vm.pc, vm.P, vm.cycles, speed, state)

    gfx_shutdown()
    return 0
